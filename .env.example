# 비밀값은 저장소 밖 키 파일에서 참조한다(변수 이름은 기존 호환으로 AZURE_CREDENTIALS_FILE 유지 — Azure 는 쓰지 않음, Q29).
# 대상 파일 형식 (KEY=VALUE, 값 앞뒤에 < > 나 따옴표를 붙이지 않는다):
#   METERED_TURN_USERNAME=...
#   METERED_TURN_PASSWORD=...
# 아래 값들은 여기(.env)에 직접 넣어도 되고, 그러면 이쪽이 우선한다.
#   비워 두면 키 파일 없이 이 .env 에 직접 넣은 값만 쓴다. 예) AZURE_CREDENTIALS_FILE=C:\keys\visionmeeting_keys.txt
AZURE_CREDENTIALS_FILE=

# 회의 정리 기본 엔진(Q18): claude | codex. Host 가 회의 화면에서 바꿀 수 있다. DeepSeek 은 유료라 제거(Q19),
# EXAONE 은 API 약관(비상업·제3자 입력·타인 개인정보 금지)으로 제거(Q33).
# Claude Code·Codex 는 서버 PC 에 설치·로그인(구독)만 하면 된다 — 키를 넣지 않는다(API 과금 방지).
# SUMMARY_PROVIDER=claude

# 회의 «개설 코드». 회의를 만들 때만 필요하고, 참여자는 회의별 비밀번호로 들어온다.
# 비워 두면 사내망(localhost/LAN)에서만 개설할 수 있고, 외부 주소(터널)에서는 개설이 막힌다.
ROOM_PASSCODE=

# 회의당 접속 지점(PC) 수 상한 (P2P 메시 한계) / 회의당 언어 수 상한 (Q12)
MAX_SITES=4
MAX_MEETING_LANGUAGES=3

# 회의당 휴대폰 보조 카메라 상한 (지점당 1대, 지점 수에는 넣지 않음)
MAX_CAMERAS=2

# 사내망 주소 (휴대폰 QR 용). run.bat(launcher.py) 가 자동으로 넘기므로 보통 비워 둔다.
# LAN_URL=https://192.168.0.10:8443

# 회의 기본 중계(Q34): cloudflare | metered. Host 가 회의 화면에서 회의마다 바꿀 수 있다.
# RELAY_PROVIDER=cloudflare

# Cloudflare Realtime TURN(기본) — 매달 1,000 GB 무료, 넘으면 $0.05/GB. 프로그램이 최근 31일 합계 900 GB 에서 음성만,
# 950 GB 에서 차단해 청구 0원을 지킨다(app/relay_budget.py). 토큰은 헤더로 보내므로 주소·로그에 남지 않는다.
#   TURN 키(대시보드 Realtime → TURN Server → Create): 키 ID 는 비밀 아님, API 토큰은 비밀(자격증명 파일 권장).
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_KEY_API_TOKEN=
#   사용량 조회: 계정 ID(비밀 아님, 대시보드 주소의 32자) + Account API 토큰(권한은 «Account Analytics Read» 하나만).
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# 내부 중계 집계 파일(바이트 수만). 비우면 data/relay_usage.json
# RELAY_USAGE_FILE=

# 선택 중계 — Metered TURN 무료 요금제(현재 Free Trial 월 500 MB, 한도에서 멈춤). 카드 등록·Auto-reload 켜지 않는다.
# 방법 1(권장): 대시보드 Credentials 에서 만든 고정 정보. 서버 주소는 비밀 아님.
#   USERNAME·PASSWORD 는 자격증명 파일(AZURE_CREDENTIALS_FILE)에 넣는 것을 권장. 여기에 넣으면 이쪽이 우선.
METERED_TURN_HOST=
# METERED_TURN_USERNAME=
# METERED_TURN_PASSWORD=
# 방법 2: API 로 접속 정보를 물어 옴(앱 이름 = <이름>.metered.live 의 <이름>, 키는 자격증명 파일 권장).
# METERED_APP_NAME=
# METERED_API_KEY=
# Host 화면 «중계 총량·사용·남은 양» — METERED_APP_NAME 과 Secret Key(대시보드 → Developers) 둘 다 필요.
# Secret Key 는 계정 전체 권한이라 서버에만 둔다(키 파일 권장). 비우면 화면에 «중계 사용량 확인 불가»와 사유.
# METERED_SECRET_KEY=
# 둘 다 비면 공개 STUN 만 써서, 회사 방화벽 뒤 참석자는 연결되지 않을 수 있다(화면에 «외부 중계 없음»).
